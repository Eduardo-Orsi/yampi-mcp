# Credenciais para o teste de integração (npm run test:integracao).
# NÃO são necessárias para rodar o servidor: lá elas são informadas na tela de
# conexão e ficam cifradas no KV.
#
# Painel da Yampi: Perfil > Credenciais de API

YAMPI_ALIAS=alias-da-sua-loja
YAMPI_USER_TOKEN=
YAMPI_USER_SECRET_KEY=
